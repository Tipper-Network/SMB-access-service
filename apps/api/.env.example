# Copy to apps/api/.env — local Access API (:4001)
# Generate peppers/keys: pnpm platform:secrets:local (from Hard Port monorepo)

HOST=127.0.0.1
PORT=4001
DATABASE_URL=postgres://hp_access_login:localdev@127.0.0.1:5432/hp_platform

ADMIN_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY=false

IP_PEPPER=
FIELD_KEYS=
INTERNAL_SIGNING_KEYS=
KEYWORD_SESSION_KEYS=

ACCESS_SKIP_2FA=true
ACCESS_TEST_OTP=123456
# RESEND_API_KEY=
# MAIL_FROM=Access <access@psyferblock.io>

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
HP_S3_BUCKET=
HP_S3_PUBLIC_BASE_URL=https://your-cdn-or-bucket-public-base.example.com
HP_S3_PREFIX=content
S3_PRESIGN_EXPIRES=900
